package DSA;

public class InsertionSort {

	public static void main(String[] args) {

		int[] nums = new int[] { 199, 101, 8, 2, 1, 6, 8, 9, 100, 2000 };
		selectionSort(nums, nums.length - 1);
		for (int i : nums) {
			System.out.println(i);
		}
	}

	private static void selectionSort(int[] nums, int last) {
		int largest = nums[0];
		int largestIndex=0;
		for (int i = 0; i <= last; i++) {
			if (nums[i] > largest) {
				largest=nums[i];
				largestIndex=i;
			}

		}
		if(largestIndex!=last) {
			swap(nums, largestIndex, last);
		}
		if (last - 1 > 0)
			selectionSort(nums, last - 1);
	}

	private static void swap(int[] nums, int i, int j) {
		int temp = nums[i];
		nums[i] = nums[j];
		nums[j] = temp;

	}
}