package datastructure;

public class LinkedList {
	Node head;
	
	public LinkedList(Node node) {
		this.head=node;
	}
	
	public void insert(int data) {
		Node node =  new Node(data, null);
		if(head==null) {
			head=node;
		}else {
			Node n= head;
			while(n.next!=null) {
				n=n.next;
			}
			n.next=node;
		}
		
	}
	public void insert(int data, int index) {
		Node copy = head;
		int currentIndex=0;
		while(copy!=null) {
			if(currentIndex==index) {
				Node temp=copy;
				Node newNode = new Node(data,copy);
				temp.next=newNode;
				
			}
			currentIndex++;
		}
		
	}
	public void insertAtStart(int data) {
		Node node =  new Node(data, null);
		node.next=head;
		head=node;
	}
	public void show() {
		Node n= head;
		while(n.next!=null) {
			System.out.println(n.data);
			n=n.next;
		}
		System.out.println(n.data);
	}
	
	
	public static void main(String[] args) {
		LinkedList linkedList = new LinkedList(new Node(0, new Node(1, new Node(3, null))));
		//linkedList.show();
		linkedList.insert(9);
		linkedList.insertAtStart(10);
		linkedList.insert(111,3);
		linkedList.insert(-1,0);
		linkedList.show();

	}

}
