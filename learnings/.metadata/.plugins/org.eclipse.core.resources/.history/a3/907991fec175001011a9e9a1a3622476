package DSA;

public class BubbleSort {

	public static void main(String[] args) {
		int[] nums = new int[] {199,101,8,2,6,8,9,100};
		bubbleSort(nums, nums.length-2);
		for (int i : nums) {
			System.out.println(i);
		}
	}

	private static void bubbleSort(int[] nums,int last) {
		for(int i=0;i<=last;i++) {
			if(nums[i]>nums[i+1]) {
				swap(nums,i,i+1);
			}
			
		}
		if(last-1>1)
		bubbleSort(nums,last-1);
	}

	private static void swap(int[] nums, int i, int j) {
		int temp=nums[i];
		nums[i]=nums[j];
		nums[j]=temp;
		
	}

}
