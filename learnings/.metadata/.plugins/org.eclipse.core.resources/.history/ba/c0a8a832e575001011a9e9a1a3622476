package datastructure;

public class LinkedList {
	Node head;
	
	public void insert(int data) {
		Node node =  new Node(data, null);
		if(head==null) {
			head=node;
		}else {
			Node n= head;
			while(n.next!=null) {
				n=n.next;
			}
			n.next=node;
		}
		
	}
	public void show() {
		Node n= head;
		while(n.next!=null) {
			System.out.println(n.data);
		}
	}

}
