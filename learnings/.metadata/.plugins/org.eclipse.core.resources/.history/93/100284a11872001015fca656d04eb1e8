package DSA;

public class MoveallZerosToEnd {

	public static void main(String[] args) {
		 int[] arr = {0, 1, 0, 3, 12};
	        moveZeros(arr);

	        for (int num : arr) {
	            System.out.print(num + " ");
	        }

	}

	private static void moveZeros(int[] arr) {
		int index=0;
		for (int i = 0; i < arr.length; i++) {
			if(arr[i]!=0) {
				arr[index]=arr[i];
				index++;
			}
			
		}
		for (int i = index; i < arr.length; i++) {
			arr[index]=0;			
		}
		
	}

}
