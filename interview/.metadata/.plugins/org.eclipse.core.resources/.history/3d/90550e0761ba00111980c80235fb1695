package interview.coding1;

public class FindMajority {

	public static void main(String[] args) {
		int[] arr = new int[] {1,1,1,1,1,1,2,1,2,2,2,2,2,2};
		int num = findMajority(arr);

	}

	private static int findMajority(int[] arr) {
		int candidate= 0;
		int count=0;
		for (int i = 0; i < arr.length; i++) {
			if(count==0) {
				candidate=arr[i];
			}
			if(arr[i]==candidate) {
				count++;
			}else {
				count--;
			}
			
		}
		count=0;
		for (int i = 0; i < arr.length; i++) {
			if (arr[i]==candidate) {
				count++;
			}
			
		}
		if(count>arr.length/2)
			return candidate;
		return 0;
	}

}
