package interview.coding1;

import java.util.HashMap;
import java.util.List;
import java.util.Map;

public class FindAppearingTwice {

	public static void main(String[] args) {
		int[] arr = new int[] { 1, 2, 3, 4, 5, 6, 1, 2, 4, 6 };
		List<Integer> result = findAppearingTwice(arr);
		System.out.println(result);
	}

	private static List<Integer> findAppearingTwice(int[] arr) {
		Map<Integer, Integer> freqMap= new HashMap<>();
		for (int i = 0; i < arr.length; i++) {
			freqMap.put(arr[i],freqMap.getOrDefault(arr[i], 0));
		}
		
		return freqMap.entrySet().stream().filter(entry->entry.getValue()==2).map(Map.Entry::getKey).toList();
	}

}
