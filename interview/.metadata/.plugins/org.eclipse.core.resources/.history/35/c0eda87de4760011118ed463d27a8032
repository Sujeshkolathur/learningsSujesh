class Singleton{
	private static Singleton instance=null;
	
	private Singleton() {
	}
	
	public Singleton getInstance() throws InterruptedException {
		if(instance==null) {
			Thread.sleep(300);
			this.instance=new Singleton();
		}
		return instance;
	}
	
}