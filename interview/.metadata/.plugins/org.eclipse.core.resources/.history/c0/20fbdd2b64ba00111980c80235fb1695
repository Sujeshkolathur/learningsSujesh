package interview.coding1;

public class MaxDiffernce {

	public static void main(String[] args) {
		int[] arr = new int[] {1,2,3,4,5,6,7,8,9,2,4,88,7,9,0,11,111,4};
		int minimumSoFar = arr[0];
		int minimumIndex=0;
		int maxDifference = 0;
		int[] indexes = new int[] {};
		for (int i = 1; i < arr.length; i++) {
			if(maxDifference<arr[i]-minimumSoFar) {
				maxDifference=Math.max(maxDifference, arr[i]-minimumSoFar);
				indexes = new int[] {minimumIndex,i};
				System.out.println("found max differenceat ="+i+"  "+minimumIndex);
			}
			if(minimumSoFar<arr[i]) {
				minimumSoFar=Math.min(minimumSoFar, arr[i]);
				minimumIndex=arr[i];
			}
			
			
		}
		System.out.println(indexes[0]+"   "+indexes[1]);
		System.out.println(maxDifference);
	}

}
