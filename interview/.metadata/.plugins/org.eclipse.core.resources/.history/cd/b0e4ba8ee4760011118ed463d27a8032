class Singleton {
	private static Singleton instance = null;

	private Singleton() {
	}

	public Singleton getInstance() {
		if (instance == null) {
			synchronized (Singleton.class) {
				if (instance == null) {
					this.instance = new Singleton();

				}
			}
			return instance;
		}
	}
}