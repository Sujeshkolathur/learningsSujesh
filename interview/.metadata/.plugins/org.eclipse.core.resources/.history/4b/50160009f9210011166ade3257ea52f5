    private static void copySingleContainer(CosmosDatabase devDb,
                                            CosmosDatabase qaDb,
                                            CosmosContainerProperties containerProps,
                                            AtomicLong totalRead,
                                            AtomicLong totalWritten,
                                            AtomicLong totalFailed) {

        String containerName = containerProps.getId();
        List<String> pkPaths = containerProps.getPartitionKeyDefinition().getPaths();
        String pkPath = pkPaths.isEmpty() ? "/id" : pkPaths.get(0); // default to /id if unknown

        logger.info("[{}] Starting copy. partitionKey={}", containerName, pkPath);

        // Ensure container exists in QA; create with same pk path if missing
        CosmosContainer qaContainer = ensureContainerExists(qaDb, containerName, pkPath, containerProps);

        // Optionally clear QA container first
        if (CLEAR_QA_FIRST) {
            logger.info("[{}] Clearing QA container first...", containerName);
            Instant clearStart = Instant.now();
            deleteAllItemsInContainer(qaContainer, pkPath);
            long clearDuration = Duration.between(clearStart, Instant.now()).getSeconds();
            logger.info("[{}] QA container cleared in {} seconds", containerName, clearDuration);
        }

        CosmosContainer devContainer = devDb.getContainer(containerName);
        logger.debug("[{}] Connected to DEV container", containerName);

        // Item-level executor (bounded)
        ExecutorService itemsExecutor = Executors.newFixedThreadPool(THREADS_ITEMS);
        logger.debug("[{}] Item executor service started with {} threads", containerName, THREADS_ITEMS);

        // Query pages from dev container
        CosmosQueryRequestOptions queryOptions = new CosmosQueryRequestOptions();
        queryOptions.setMaxBufferedItemCount(PAGE_SIZE);
        String query = "SELECT * FROM c";

        logger.info("[{}] Starting to query items from DEV container...", containerName);
        Instant queryStart = Instant.now();
        CosmosPagedIterable<ObjectNode> pages = devContainer.queryItems(query, queryOptions, ObjectNode.class);

        AtomicLong containerRead = new AtomicLong(0);
        AtomicLong containerWritten = new AtomicLong(0);
        AtomicLong containerFailed = new AtomicLong(0);
        AtomicLong pageCount = new AtomicLong(0);

        // Process futures in batches to avoid memory issues
        List<Future<?>> currentBatch = new ArrayList<>();
        AtomicInteger batchNumber = new AtomicInteger(0);

        // Iterate pages and submit item writes
        pages.iterableByPage(PAGE_SIZE).forEach(page -> {
            long currentPage = pageCount.incrementAndGet();
            
            // Convert to list to get size and iterate
            List<ObjectNode> pageItems = new ArrayList<>();
            page.getElements().forEach(pageItems::add);
            int itemsInPage = pageItems.size();
            logger.debug("[{}] Processing page {} with {} items", containerName, currentPage, itemsInPage);

            pageItems.forEach(item -> {
                containerRead.incrementAndGet();
                totalRead.incrementAndGet();

                // Submit write task
                Future<?> future = itemsExecutor.submit(() -> {
                    try {
                        // Remove system metadata
                        item.remove("_etag");
                        item.remove("_ts");
                        item.remove("_self");
                        item.remove("_rid");
                        item.remove("_attachments");

                        // Resolve partition key value: assume first pk path, e.g. "/pk"
                        Object pkValue = extractPartitionKeyValue(item, pkPath);
                        
                        if (pkValue == null) {
                            logger.warn("[{}] Item has null partition key, skipping. Item id: {}", 
                                    containerName, item.get("id"));
                            containerFailed.incrementAndGet();
                            totalFailed.incrementAndGet();
                            return;
                        }

                        // Upsert item with retry logic
                        boolean success = upsertItemWithRetry(qaContainer, item, pkValue, containerName);
                        
                        if (success) {
                            containerWritten.incrementAndGet();
                            totalWritten.incrementAndGet();
                        } else {
                            containerFailed.incrementAndGet();
                            totalFailed.incrementAndGet();
                        }
                    } catch (Exception e) {
                        logger.error("[{}] Failed to upsert item: {}", containerName, e.getMessage(), e);
                        containerFailed.incrementAndGet();
                        totalFailed.incrementAndGet();
                    }
                });
                
                currentBatch.add(future);

                // Process batch when it reaches the batch size
                if (currentBatch.size() >= FUTURE_BATCH_SIZE) {
                    processBatch(currentBatch, containerName, batchNumber.getAndIncrement());
                    currentBatch.clear();
                }
            });

            // Optional: throttle small pause to avoid bursting RUs too hard
            try {
                Thread.sleep(10);
            } catch (InterruptedException e) {
                logger.warn("[{}] Interrupted during throttling pause", containerName);
                Thread.currentThread().interrupt();
            }
        });

        // Process remaining futures in the last batch
        if (!currentBatch.isEmpty()) {
            processBatch(currentBatch, containerName, batchNumber.get());
        }

        long queryDuration = Duration.between(queryStart, Instant.now()).getSeconds();
        logger.info("[{}] Finished querying items in {} seconds. Total pages: {}", 
                containerName, queryDuration, pageCount.get());

        // Wait for all item tasks to finish with proper shutdown
        logger.info("[{}] Waiting for all write operations to complete...", containerName);
        itemsExecutor.shutdown();
        try {
            if (!itemsExecutor.awaitTermination(EXECUTOR_SHUTDOWN_TIMEOUT_SECONDS, TimeUnit.SECONDS)) {
                logger.warn("[{}] Item executor did not terminate within {} seconds, forcing shutdown", 
                        containerName, EXECUTOR_SHUTDOWN_TIMEOUT_SECONDS);
                itemsExecutor.shutdownNow();
            }
        } catch (InterruptedException e) {
            logger.error("[{}] Interrupted while shutting down item executor", containerName, e);
            itemsExecutor.shutdownNow();
            Thread.currentThread().interrupt();
        }

        logger.info("[{}] Container copy completed. read={}, written={}, failed={}", 
                containerName, containerRead.get(), containerWritten.get(), containerFailed.get());
    }

    private static CosmosContainer ensureContainerExists(CosmosDatabase qaDb,
                                                         String containerName,
                                                         String pkPath,
                                                         CosmosContainerProperties sourceProps) {
        try {
            // Try to read container
            CosmosContainer container = qaDb.getContainer(containerName);
            container.read(); // will throw if not exists
            logger.info("[{}] Container exists in QA", containerName);
            return container;
        } catch (Exception ex) {
            // Create container with all properties copied from source
            logger.info("[{}] Container missing in QA; creating with properties from source", containerName);
            
            // Create new container properties with partition key
            CosmosContainerProperties props = new CosmosContainerProperties(containerName, pkPath);
            
            // Copy indexing policy from source
            if (sourceProps.getIndexingPolicy() != null) {
                props.setIndexingPolicy(sourceProps.getIndexingPolicy());
                logger.debug("[{}] Copied indexing policy from source", containerName);
            }
            
            // Copy unique key policy from source
            if (sourceProps.getUniqueKeyPolicy() != null) {
                props.setUniqueKeyPolicy(sourceProps.getUniqueKeyPolicy());
                logger.debug("[{}] Copied unique key policy from source", containerName);
            }
            
            // Copy default TTL from source
            if (sourceProps.getDefaultTimeToLiveInSeconds() != null) {
                props.setDefaultTimeToLiveInSeconds(sourceProps.getDefaultTimeToLiveInSeconds());
                logger.debug("[{}] Copied default TTL ({} seconds) from source", 
                        containerName, sourceProps.getDefaultTimeToLiveInSeconds());
            }
            
            // Copy conflict resolution policy from source
            if (sourceProps.getConflictResolutionPolicy() != null) {
                props.setConflictResolutionPolicy(sourceProps.getConflictResolutionPolicy());
                logger.debug("[{}] Copied conflict resolution policy from source", containerName);
            }
            
            // Copy analytical store TTL from source
            if (sourceProps.getAnalyticalStoreTimeToLiveInSeconds() != null) {
                props.setAnalyticalStoreTimeToLiveInSeconds(sourceProps.getAnalyticalStoreTimeToLiveInSeconds());
                logger.debug("[{}] Copied analytical store TTL from source", containerName);
            }
           
            
            // Copy computed properties if present
            if (sourceProps.getComputedProperties() != null && !sourceProps.getComputedProperties().isEmpty()) {
                props.setComputedProperties(sourceProps.getComputedProperties());
                logger.debug("[{}] Copied {} computed properties from source", 
                        containerName, sourceProps.getComputedProperties().size());
            }
            
            // Copy client encryption policy if present
            if (sourceProps.getClientEncryptionPolicy() != null) {
                props.setClientEncryptionPolicy(sourceProps.getClientEncryptionPolicy());
                logger.debug("[{}] Copied client encryption policy from source", containerName);
            }
            
            // Copy change feed policy if present
            if (sourceProps.getChangeFeedPolicy() != null) {
                props.setChangeFeedPolicy(sourceProps.getChangeFeedPolicy());
                logger.debug("[{}] Copied change feed policy from source", containerName);
            }
            
            // Try to create container with throughput first (for provisioned accounts)
            // If it fails with serverless error, retry without throughput
            try {
                ThroughputProperties tp = ThroughputProperties.createAutoscaledThroughput(4000);
                qaDb.createContainerIfNotExists(props, tp);
                logger.info("[{}] Container created successfully in QA with autoscale throughput (4000 RU)", containerName);
            } catch (CosmosException e) {
                // Check if error is due to serverless account
                if (e.getStatusCode() == 400 && 
                    e.getMessage() != null && 
                    e.getMessage().contains("serverless accounts")) {
                    logger.info("[{}] QA database is serverless - creating container without throughput", containerName);
                    // Retry without throughput for serverless accounts
                    qaDb.createContainerIfNotExists(props);
                    logger.info("[{}] Container created successfully in QA (serverless mode, no throughput set)", containerName);
                } else {
                    // Re-throw if it's a different error
                    throw e;
                }
            }
            
            return qaDb.getContainer(containerName);
        }
    }

    private static void deleteAllItemsInContainer(CosmosContainer container, String pkPath) {
        String containerName = container.getId();
        logger.info("[{}] Starting to delete all items from container...", containerName);
        
        AtomicLong deletedCount = new AtomicLong(0);
        AtomicLong failedCount = new AtomicLong(0);
        
        // Simple approach: read all items and delete by partition key
        CosmosQueryRequestOptions options = new CosmosQueryRequestOptions();
        options.setMaxBufferedItemCount(PAGE_SIZE);
        CosmosPagedIterable<ObjectNode> items = container.queryItems("SELECT c.id, c" + getPkJsonFragment(pkPath) + " FROM c", options, ObjectNode.class);

        items.iterableByPage(PAGE_SIZE).forEach(page -> {
            page.getElements().forEach(item -> {
                try {
                    JsonNode idNode = item.get("id");
                    String id = idNode != null ? idNode.asText() : null;
                    Object pkValue = extractPartitionKeyValue(item, pkPath);
                    if (id != null && pkValue != null) {
                        container.deleteItem(id, new PartitionKey(pkValue), new CosmosItemRequestOptions());
                        deletedCount.incrementAndGet();
                    } else {
                        logger.warn("[{}] Skipping delete - item has null id or partition key", containerName);
                        failedCount.incrementAndGet();
                    }
                } catch (Exception e) {
                    logger.error("[{}] Delete item failed: {}", containerName, e.getMessage());
                    failedCount.incrementAndGet();
                }
            });
        });
        
        logger.info("[{}] Deletion completed. deleted={}, failed={}", containerName, deletedCount.get(), failedCount.get());
    }

    // Helper: extract partition key value from item given partition path like "/pk"
    private static Object extractPartitionKeyValue(JsonNode item, String pkPath) {
        // Remove leading slash
        String path = pkPath.startsWith("/") ? pkPath.substring(1) : pkPath;
        JsonNode pkNode = item.get(path);
        if (pkNode == null || pkNode.isNull()) {
            // fallback to id
            JsonNode id = item.get("id");
            return id != null ? id.asText() : null;
        }
        if (pkNode.isTextual()) return pkNode.asText();
        if (pkNode.isNumber()) return pkNode.numberValue();
        // other types -> use string
        return pkNode.toString();
    }

    private static void processBatch(List<Future<?>> batch, String containerName, int batchNumber) {
        logger.debug("[{}] Processing batch {} with {} futures", containerName, batchNumber, batch.size());
        for (Future<?> f : batch) {
            try {
                f.get(); // Wait for completion
            } catch (InterruptedException ie) {
                logger.error("[{}] Interrupted while waiting for batch {} future", containerName, batchNumber, ie);
                Thread.currentThread().interrupt();
            } catch (ExecutionException ee) {
                logger.error("[{}] Item write task failed in batch {}: {}", containerName, batchNumber, ee.getMessage());
            }
        }
        logger.debug("[{}] Batch {} completed", containerName, batchNumber);
    }

    private static boolean upsertItemWithRetry(CosmosContainer container, ObjectNode item, Object pkValue, String containerName) {
        int attempt = 0;
        while (attempt < MAX_RETRIES) {
            try {
                container.upsertItem(item, new PartitionKey(pkValue), new CosmosItemRequestOptions());
                if (attempt > 0) {
                    logger.debug("[{}] Item upsert succeeded after {} retries. Item id: {}", 
                            containerName, attempt, item.get("id"));
                }
                return true;
            } catch (CosmosException e) {
                attempt++;
                if (e.getStatusCode() == 429) {
                    // Rate limiting - retry with backoff
                    long retryAfter = e.getRetryAfterDuration().toMillis();
                    if (attempt < MAX_RETRIES) {
                        logger.warn("[{}] Rate limited (429) on attempt {}/{}. Retrying after {}ms. Item id: {}", 
                                containerName, attempt, MAX_RETRIES, retryAfter, item.get("id"));
                        try {
                            Thread.sleep(Math.max(retryAfter, RETRY_DELAY_MS));
                        } catch (InterruptedException ie) {
                            Thread.currentThread().interrupt();
                            logger.error("[{}] Interrupted during retry delay", containerName);
                            return false;
                        }
                    } else {
                        logger.error("[{}] Rate limited (429) - max retries exceeded. Item id: {}", 
                                containerName, item.get("id"));
                        return false;
                    }
                } else if (e.getStatusCode() >= 500) {
                    // Server error - retry
                    if (attempt < MAX_RETRIES) {
                        logger.warn("[{}] Server error {} on attempt {}/{}. Retrying in {}ms. Item id: {}", 
                                containerName, e.getStatusCode(), attempt, MAX_RETRIES, RETRY_DELAY_MS, item.get("id"));
                        try {
                            Thread.sleep(RETRY_DELAY_MS * attempt); // Exponential backoff
                        } catch (InterruptedException ie) {
                            Thread.currentThread().interrupt();
                            logger.error("[{}] Interrupted during retry delay", containerName);
                            return false;
                        }
                    } else {
                        logger.error("[{}] Server error {} - max retries exceeded. Item id: {}", 
                                containerName, e.getStatusCode(), item.get("id"));
                        return false;
                    }
                } else {
                    // Client error (4xx) - don't retry
                    logger.error("[{}] Client error {} on upsert. Not retrying. Item id: {}", 
                            containerName, e.getStatusCode(), item.get("id"));
                    return false;
                }
            } catch (Exception e) {
                attempt++;
                if (attempt < MAX_RETRIES) {
                    logger.warn("[{}] Unexpected error on attempt {}/{}. Retrying in {}ms. Item id: {}. Error: {}", 
                            containerName, attempt, MAX_RETRIES, RETRY_DELAY_MS, item.get("id"), e.getMessage());
                    try {
                        Thread.sleep(RETRY_DELAY_MS * attempt);
                    } catch (InterruptedException ie) {
                        Thread.currentThread().interrupt();
                        logger.error("[{}] Interrupted during retry delay", containerName);
                        return false;
                    }
                } else {
                    logger.error("[{}] Unexpected error - max retries exceeded. Item id: {}. Error: {}", 
                            containerName, item.get("id"), e.getMessage());
                    return false;
                }
            }
        }
        return false;
    }

