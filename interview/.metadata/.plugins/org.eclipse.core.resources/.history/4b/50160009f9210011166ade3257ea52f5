    private static String getenv(String name) {
        String v = System.getenv(name);
        if (v == null) v = System.getProperty(name);
        return v;
    }

    private static String getenvOrDefault(String name, String def) {
        String v = getenv(name);
        return v == null ? def : v;
    }
    
    /**
     * Parse container filter from comma-separated string
     * @param filterStr Comma-separated container names (e.g., "container1,container2,container3")
     * @return Set of container names to filter, empty set if filterStr is empty/null
     */
    private static Set<String> parseContainerFilter(String filterStr) {
        if (filterStr == null || filterStr.trim().isEmpty()) {
            return new HashSet<>();
        }
        return Arrays.stream(filterStr.split(","))
                .map(String::trim)
                .filter(s -> !s.isEmpty())
                .collect(Collectors.toSet());
    }
