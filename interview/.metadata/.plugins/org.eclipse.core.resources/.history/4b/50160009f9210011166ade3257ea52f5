    private static void validateEnv() {
        logger.info("Validating connection strings...");
        if (DEV_URI == null || DEV_URI.isEmpty() || DEV_URI.contains("your-") ||
                DEV_KEY == null || DEV_KEY.isEmpty() || DEV_KEY.contains("your-") ||
                DEV_DB == null || DEV_DB.isEmpty() || DEV_DB.contains("your-") ||
                QA_URI == null || QA_URI.isEmpty() || QA_URI.contains("your-") ||
                QA_KEY == null || QA_KEY.isEmpty() || QA_KEY.contains("your-") ||
                QA_DB == null || QA_DB.isEmpty() || QA_DB.contains("your-")) {
            logger.error("Connection strings are not configured. Please update the hardcoded values in the code.");
            logger.error("DEV_URI={}, DEV_DB={}, QA_URI={}, QA_DB={}", DEV_URI, DEV_DB, QA_URI, QA_DB);
            System.exit(1);
        }
        logger.info("Connection strings validated successfully");
