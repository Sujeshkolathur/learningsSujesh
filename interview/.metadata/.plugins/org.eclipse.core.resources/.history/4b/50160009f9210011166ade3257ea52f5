                    long containerDuration = Duration.between(containerStartTime, Instant.now()).getSeconds();
                    logger.info("[{}] Container copy completed successfully in {} seconds", containerName, containerDuration);
                } catch (Exception e) {
                    long containerDuration = Duration.between(containerStartTime, Instant.now()).getSeconds();
                    logger.error("[{}] Error copying container after {} seconds: {}", 
                            containerName, containerDuration, e.getMessage(), e);
                } finally {
                    latch.countDown();
                    logger.debug("[{}] Container task completed, remaining: {}", containerName, latch.getCount());
                }
            });
        }

        logger.info("Waiting for all {} containers to complete...", containers.size());
        try {
            latch.await(); // wait for all containers to finish
            logger.info("All container tasks completed");
        } catch (InterruptedException e) {
            logger.error("Interrupted while waiting for containers to complete", e);
            Thread.currentThread().interrupt();
        } finally {
            logger.info("Shutting down container executor...");
            containerExecutor.shutdown();
            try {
                if (!containerExecutor.awaitTermination(EXECUTOR_SHUTDOWN_TIMEOUT_SECONDS, TimeUnit.SECONDS)) {
                    logger.warn("Container executor did not terminate within {} seconds, forcing shutdown", 
                            EXECUTOR_SHUTDOWN_TIMEOUT_SECONDS);
                    containerExecutor.shutdownNow();
                }
