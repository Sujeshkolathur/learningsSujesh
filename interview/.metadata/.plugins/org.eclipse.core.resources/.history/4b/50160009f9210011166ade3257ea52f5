                logger.error("Interrupted while shutting down container executor", e);
                containerExecutor.shutdownNow();
                Thread.currentThread().interrupt();
            }
            
            logger.info("Closing Cosmos DB clients...");
            devClient.close();
            qaClient.close();
            logger.info("Clients closed");
        }

        long totalDuration = Duration.between(startTime, Instant.now()).getSeconds();
        logger.info("==========================================");
