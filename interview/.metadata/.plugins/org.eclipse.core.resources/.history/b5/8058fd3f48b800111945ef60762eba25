package interview.coding1;

public class MoveAllZerosToEnd {

	public static void main(String[] args) {
		int[] arr = new int[] {1,0,4,5,7,9,0,3};
		for (int i : arr) {
			System.out.println(i);
		}
	}

	private static int[] move(int[] arr) {
		int index=0;
		
		for (int i = 0; i < arr.length; i++) {
			if(arr[i]!=0) {
				index++;
			}else {
				arr[index]=arr[i];
				arr[i]=0;
			}
		}
		return arr;
	}

}
