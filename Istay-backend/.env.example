# Copy to .env and load into your shell / IDE run config.
# Never commit real .env files.

SPRING_PROFILES_ACTIVE=local

# Database
ISTAY_DB_URL=jdbc:postgresql://localhost:5432/istay
ISTAY_DB_USERNAME=istay
ISTAY_DB_PASSWORD=istay

# JWT (Base64 or raw string, >= 32 bytes). Required in prod; local has a safe default.
# ISTAY_JWT_SECRET=
ISTAY_JWT_EXPIRATION_MINUTES=480

# CORS (comma-separated)
ISTAY_CORS_ALLOWED_ORIGINS=http://localhost:5173

# --- Production example ---
# SPRING_PROFILES_ACTIVE=prod
# ISTAY_DB_URL=jdbc:postgresql://db.internal:5432/istay
# ISTAY_DB_USERNAME=istay_app
# ISTAY_DB_PASSWORD=replace-me
# ISTAY_JWT_SECRET=replace-with-long-random-secret-at-least-32-bytes
# ISTAY_JWT_EXPIRATION_MINUTES=60
# ISTAY_CORS_ALLOWED_ORIGINS=https://app.example.com
